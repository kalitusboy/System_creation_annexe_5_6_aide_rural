## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core / .NET 8 specific
project.lock.json
project.fragment.lock.json
artifacts/

# SQLite files (optional, but usually not committed)
*.db
*.db-shm
*.db-wal

# JSON settings with local data (keep template but ignore actual)
**/appsettings.json
**/appsettings.Development.json
**/appsettings.Production.json

# Local data folder created by the app
%LocalAppData%/HabitatRural/
**/bin/
**/obj/
**/Assets/Templates/*.pdf   # القوالب الرسمية لا ترفع إلى GitHub (حقوق ملكية)

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results of Visual Studio (like .nupkg)
*.nupkg
*.snupkg

# Windows Store app package directory
AppPackages/

# Others
*.pidb
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.scc
*.vsidx