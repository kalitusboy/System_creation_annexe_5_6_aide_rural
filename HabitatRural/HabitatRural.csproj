<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HabitatRural</AssemblyName>
    <RootNamespace>HabitatRural</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <Product>نظام ملاحق المساعدة الريفية</Product>
    <Company>حميتي نسيم الحوضان</Company>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- ملء نماذج PDF الرسمية -->
    <PackageReference Include="PdfSharpCore"          Version="1.3.65" />
    <!-- قاعدة بيانات SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4"  />
  </ItemGroup>

  <!-- قوالب PDF الرسمية -->
  <ItemGroup>
    <None Update="Assets\Templates\Annexe_05_Officiel.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Templates\Annexe_06_Officiel.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
