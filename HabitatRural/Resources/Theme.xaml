<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ Palette modern / professional ═══════════ -->
    <Color x:Key="PrimaryDarkColor">#FF0B2B44</Color>
    <Color x:Key="PrimaryColor">#FF14507A</Color>
    <Color x:Key="PrimaryLightColor">#FF1E7DBF</Color>
    <Color x:Key="AccentColor">#FF4F46E5</Color>
    <Color x:Key="AccentLightColor">#FFE0E7FF</Color>

    <Color x:Key="SuccessColor">#FF15803D</Color>
    <Color x:Key="WarnColor">#FFD97706</Color>
    <Color x:Key="DangerColor">#FFDC2626</Color>
    <Color x:Key="InfoColor">#FF0369A1</Color>

    <Color x:Key="BgColor">#FFEEF2F7</Color>
    <Color x:Key="BgSoftColor">#FFF8FAFC</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFE2E8F0</Color>
    <Color x:Key="TextColor">#FF1E293B</Color>
    <Color x:Key="TextSecondaryColor">#FF64748B</Color>
    <Color x:Key="LabelColor">#FF1E4A76</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"     Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="BgBrush"          Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSoftBrush"      Color="{StaticResource BgSoftColor}"/>
    <SolidColorBrush x:Key="CardBrush"        Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"        Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="LabelBrush"       Color="{StaticResource LabelColor}"/>

    <!-- Gradient brushes للهيدر -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColor}"     Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogicGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEEF2FF" Offset="0"/>
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1E7E34" Offset="0"/>
        <GradientStop Color="{StaticResource SuccessColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default font -->
    <FontFamily x:Key="UiFont">Segoe UI, Tahoma, Geneva, Arial</FontFamily>

</ResourceDictionary>
