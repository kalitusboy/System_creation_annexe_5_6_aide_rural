<Window x:Class="HabitatRural.Views.BeneficiaireEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة / تعديل مستفيد"
        Height="380" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📝  بيانات المستفيد"
                   FontSize="15" FontWeight="Bold"
                   Foreground="#FF0B2B44" Margin="0,0,0,18"/>

        <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top">
            <StackPanel Margin="0,0,8,12">
                <TextBlock Text="🔢 رقم المقرر (Code — 17 رقم) *"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF1E4A76"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCode" Style="{StaticResource ModernTextBox}"
                         MaxLength="17"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,12">
                <TextBlock Text="👤 الاسم واللقب *"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF1E4A76"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNom" Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,12">
                <TextBlock Text="🏠 الفرقة / العنوان *"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF1E4A76"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAdresse" Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,12">
                <TextBlock Text="📅 تاريخ القرار *"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF1E4A76"
                           Margin="0,0,0,4"/>
                <DatePicker x:Name="DpDate" Style="{StaticResource ModernDatePicker}"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0" Grid.ColumnSpan="2">
                <TextBlock Text="🏦 رقم CCP / حساب بنكي *"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF1E4A76"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCcp" Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="إلغاء" Click="BtnCancel_Click"
                    Padding="18,8" Margin="0,0,10,0"
                    Background="#FF6B7280" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="💾  حفظ" Click="BtnSave_Click"
                    Padding="22,8" FontWeight="Bold"
                    Background="{StaticResource SuccessBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
