<Window x:Class="HabitatRural.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة الملحق"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="PrintBtn" Content="طباعة" Width="80" Margin="5" Click="Print_Click"/>
            <Button x:Name="CloseBtn" Content="إغلاق" Width="80" Margin="5" Click="Close_Click"/>
        </StackPanel>
        <WebBrowser x:Name="WebBrowser" Grid.Row="1"/>
    </Grid>
</Window>
