<Window x:Class="HabitatRural.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات العامة" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" Background="White"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="الإعدادات العامة" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="معلومات الجهة" Margin="0,0,0,15">
                    <UniformGrid Columns="2" Margin="10">
                        <TextBlock Text="الولاية:" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtWilaya" Margin="5"/>
                        <TextBlock Text="الدائرة:" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtDaira" Margin="5"/>
                        <TextBlock Text="البلدية:" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtCommune" Margin="5"/>
                    </UniformGrid>
                </GroupBox>
                <GroupBox Header="الإعانة المالية" Margin="0,0,0,15">
                    <UniformGrid Columns="2" Margin="10">
                        <TextBlock Text="المبلغ الإجمالي (دج):" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtTotalAmount" Margin="5"/>
                        <TextBlock Text="نسبة الشطر الأول (%):" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtPctT1" Margin="5"/>
                        <TextBlock Text="نسبة الشطر الثاني (%):" Margin="5" VerticalAlignment="Center"/><TextBox x:Name="TxtPctT2" Margin="5"/>
                    </UniformGrid>
                </GroupBox>
                <GroupBox Header="قائمة Subdivisionnaires">
                    <StackPanel>
                        <Button Content="إضافة" Click="BtnAddSubdiv_Click" Width="80" Margin="10,0,0,10" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="SubdivList">
                            <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="5"><Button Content="حذف" Width="60" Click="BtnRemoveSubdiv_Click" Tag="{Binding}" DockPanel.Dock="Left" Margin="0,0,5,0"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button Content="حفظ" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="إلغاء" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>