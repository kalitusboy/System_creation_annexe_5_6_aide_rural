<Window x:Class="HabitatRural.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام ملاحق الإعانة الريفية – Annexes 05 &amp; 06"
        Height="820" Width="1060"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>  <!-- شريط العنوان -->
            <RowDefinition Height="*"/>   <!-- المحتوى -->
        </Grid.RowDefinitions>

        <!-- ════════════════════ شريط العنوان ════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <!-- أزرار التنقل (تظهر على اليمين في RTL) -->
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙  الإعدادات" Style="{StaticResource HeaderIconButton}"
                            Click="BtnSettings_Click" Margin="0,0,8,0"/>
                    <Button Content="ℹ  حول البرنامج" Style="{StaticResource HeaderIconButton}"
                            Click="BtnAbout_Click"/>
                </StackPanel>
                <!-- العنوان (مُمركز) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="نظام تحرير ملاحق السكن الريفي"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Annexes 05 et 06 — حقن مباشر في القوالب الرسمية"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ المحتوى ════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,24">

                <!-- ═══ اختيار نوع الملحق ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="اختر نوع الملحق"/>
                <UniformGrid Columns="2" Margin="0,0,0,14" Height="68">
                    <RadioButton x:Name="RbAnnexe5" GroupName="annexe" IsChecked="True"
                                 Style="{StaticResource BigSelectorRadio}" Margin="0,0,8,0"
                                 Checked="AnnexeType_Changed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Annexe 5"   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="طلب الدفع"  FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbAnnexe6" GroupName="annexe"
                                 Style="{StaticResource BigSelectorRadio}"
                                 Checked="AnnexeType_Changed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Annexe 6"          FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="محضر المعاينة"     FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- ═══ نوع البناء ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="نوع البناء"/>
                <UniformGrid Columns="2" Margin="0,0,0,14" Height="58">
                    <RadioButton x:Name="RbTalia" GroupName="build" IsChecked="True"
                                 Style="{StaticResource BigSelectorRadio}" Margin="0,0,8,0"
                                 Checked="Logic_Changed">
                        <TextBlock Text="تعلية  (Surélévation)" FontSize="13" FontWeight="SemiBold"/>
                    </RadioButton>
                    <RadioButton x:Name="RbArdhi" GroupName="build"
                                 Style="{StaticResource BigSelectorRadio}"
                                 Checked="Logic_Changed">
                        <TextBlock Text="بناية أرضية" FontSize="13" FontWeight="SemiBold"/>
                    </RadioButton>
                </UniformGrid>

                <!-- ═══ الشطر ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="الشطر"/>
                <WrapPanel Margin="0,0,0,14">
                    <RadioButton x:Name="RbT1"   GroupName="tranche" IsChecked="True"
                                 Style="{StaticResource PillRadio}" Checked="Logic_Changed">
                        <TextBlock Text="الشطر الأول فقط"/>
                    </RadioButton>
                    <RadioButton x:Name="RbT2"   GroupName="tranche"
                                 Style="{StaticResource PillRadio}" Checked="Logic_Changed">
                        <TextBlock Text="الشطر الثاني فقط"/>
                    </RadioButton>
                    <RadioButton x:Name="RbBoth" GroupName="tranche"
                                 Style="{StaticResource PillRadio}" Checked="Logic_Changed">
                        <TextBlock Text="الشطرين معاً"/>
                    </RadioButton>
                </WrapPanel>

                <!-- ═══ ملخص المنطق ═══ -->
                <Border Style="{StaticResource LogicPanel}">
                    <TextBlock x:Name="TxtLogicSummary" Text="— سيتم التحديث —"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                </Border>

                <!-- ═══ البحث والمستفيدون ═══ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="بحث سريع عن مستفيد"/>

                        <!-- بحث بـ 5 أرقام -->
                        <DockPanel Margin="0,0,0,10">
                            <Button Content="بحث"
                                    Style="{StaticResource SmallButton}"
                                    Background="{StaticResource AccentBrush}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0"
                                    Click="BtnSearch_Click"/>
                            <Grid>
                                <TextBox x:Name="TxtSearchCode" Style="{StaticResource ModernTextBox}"
                                         KeyDown="TxtSearchCode_KeyDown"/>
                                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="12,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="أدخل آخر 5 أرقام من الكود …">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchCode}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="5 أرقام من الكود:"
                                       VerticalAlignment="Center" DockPanel.Dock="Right"
                                       Margin="0,0,10,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>

                        <!-- قائمة المستفيدين المحفوظين -->
                        <DockPanel>
                            <Button Content="🗑 حذف"
                                    Style="{StaticResource SmallButton}"
                                    Background="{StaticResource GrayBrush}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0"
                                    Click="BtnDeleteBeneficiaire_Click"/>
                            <Button Content="💾 حفظ / تحديث"
                                    Style="{StaticResource SmallButton}"
                                    Background="{StaticResource AccentBrush}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0"
                                    Click="BtnSaveBeneficiaire_Click"/>
                            <ComboBox x:Name="CbExistingBeneficiaires"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="CbExistingBeneficiaires_SelectionChanged"/>
                            <TextBlock Text="المستفيدون المحفوظون:"
                                       FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource LabelBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ البيانات المشتركة ═══ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="بيانات المستفيد المشتركة"/>

                        <!-- رقم الكود (عرض كامل) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="رقم المقرر (Code) "/>
                                <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                <Run Text=" — 17 رقم" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </TextBlock>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0" Width="130">
                                    <TextBlock Text="آخر 5 أرقام (تلقائي)"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtLast5" Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True" Background="{StaticResource BgSoftBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="TxtCode" Style="{StaticResource ModernTextBox}"
                                         TextChanged="TxtCode_TextChanged"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- الاسم + CCP -->
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="الاسم واللقب "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBox x:Name="TxtNomPrenom" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="رقم CCP / حساب بنكي "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBox x:Name="TxtCcp" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- العنوان + تاريخ القرار -->
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="الفرقة / العنوان "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBox x:Name="TxtAdresse" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="تاريخ القرار "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <DatePicker x:Name="DpDateDecision" Style="{StaticResource ModernDatePicker}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ حقول Annexe 5 فقط ═══ -->
                <Border x:Name="PanelAnnexe5Fields" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="حقل خاص بـ Annexe 5"/>
                        <StackPanel HorizontalAlignment="Left" MinWidth="300">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="تاريخ الطلب (Date demande) "/>
                                <Run Text="[اختياري]" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                            </TextBlock>
                            <DockPanel>
                                <Button Content="× فارغ" Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayBrush}"
                                        DockPanel.Dock="Left" Margin="0,0,8,0"
                                        Click="BtnClearDateDemande_Click"/>
                                <DatePicker x:Name="DpDateDemande" Style="{StaticResource ModernDatePicker}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ حقول Annexe 6 فقط ═══ -->
                <Border x:Name="PanelAnnexe6Fields" Style="{StaticResource CardBorder}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="حقول خاصة بـ Annexe 6"/>

                        <!-- الصف 1: Subdivisionnaire + رقم الرخصة + تاريخ الرخصة -->
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="اسم Subdivisionnaire "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <ComboBox x:Name="CbSubdiv" Style="{StaticResource ModernComboBox}" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="رقم رخصة البناء "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBox x:Name="TxtPermisNum" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="تاريخ رخصة البناء "/>
                                    <Run Text="*" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <DatePicker x:Name="DpDatePermis" Style="{StaticResource ModernDatePicker}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- الصف 2: تاريخ المعاينة + تاريخ المحضر + ملاحظة 1 -->
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="تاريخ المعاينة "/>
                                    <Run Text="[اختياري]" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                </TextBlock>
                                <DatePicker x:Name="DpDateVisite" Style="{StaticResource ModernDatePicker}"/>
                                <Button Content="× فارغ" Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayBrush}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Click="BtnClearDateVisite_Click"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="تاريخ إعداد المحضر (PV) "/>
                                    <Run Text="[اختياري]" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                </TextBlock>
                                <DatePicker x:Name="DpDatePV" Style="{StaticResource ModernDatePicker}"/>
                                <Button Content="× فارغ" Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayBrush}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Click="BtnClearDatePV_Click"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ملاحظة الشطر الأول"/>
                                <TextBox x:Name="TxtObs1" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- الصف 3: ملاحظة 2 + ملاحظة تكميلية -->
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ملاحظة الشطر الثاني"/>
                                <TextBox x:Name="TxtObs2" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ملاحظة تكميلية (Observation complémentaire)"/>
                                <TextBox x:Name="TxtObsComp" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ زر الإنشاء والمعاينة ═══ -->
                <Button x:Name="BtnGenerate"
                        Style="{StaticResource GenerateButton}"
                        Content="📄  إنشاء ومعاينة PDF  —  الملحق سيُحفظ تلقائياً في الأرشيف"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,16"
                        Click="BtnGenerate_Click"/>

                <!-- ═══ الأرشيف ═══ -->
                <Expander Margin="0,0,0,12"
                          Foreground="{StaticResource TextBrush}"
                          FontWeight="SemiBold" FontSize="13">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="🗂  الأرشيف — الملاحق المحفوظة  ("/>
                            <Run x:Name="RunArchiveCount" Text="0"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </Expander.Header>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- أزرار الأرشيف -->
                            <WrapPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <Button Content="🔄 تحديث"  Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayLightBrush}"
                                        Foreground="{StaticResource TextBrush}"
                                        Margin="0,0,8,0" Click="BtnRefreshArchive_Click"/>
                                <Button Content="🗑 حذف محدد" Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayBrush}"
                                        Margin="0,0,8,0" Click="BtnDeleteArchive_Click"/>
                                <Button Content="📂 فتح مجلد الأرشيف" Style="{StaticResource SmallButton}"
                                        Background="{StaticResource GrayLightBrush}"
                                        Foreground="{StaticResource TextBrush}"
                                        Click="BtnOpenArchiveFolder_Click"/>
                            </WrapPanel>
                            <!-- جدول الأرشيف -->
                            <DataGrid x:Name="DgArchives"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True" SelectionMode="Single"
                                      MaxHeight="210"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="White" BorderThickness="0"
                                      AlternatingRowBackground="{StaticResource BgSoftBrush}"
                                      RowBackground="White" FontSize="12"
                                      ColumnHeaderHeight="30"
                                      MouseDoubleClick="DgArchives_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ"   Binding="{Binding GeneratedAtStr}" Width="130"/>
                                    <DataGridTextColumn Header="المستفيد"  Binding="{Binding NomPrenom}"      Width="*"/>
                                    <DataGridTextColumn Header="الملحق"    Binding="{Binding AnnexeType}"     Width="80"/>
                                    <DataGridTextColumn Header="الشطر"     Binding="{Binding Tranche}"        Width="65"/>
                                    <DataGridTextColumn Header="النوع"     Binding="{Binding Building}"       Width="65"/>
                                    <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}"       Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="انقر نقرًا مزدوجًا لفتح الملحق"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- ═══ سجل العمليات (تشخيص) ═══ -->
                <Expander Margin="0,0,0,8"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="11" FontWeight="Normal" Header="🔧  سجل العمليات (تشخيص)">
                    <Border Background="#FF111827" CornerRadius="8" Padding="12" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="11" Foreground="#FF86EFAC"
                                                   Margin="0,1" FlowDirection="LeftToRight"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════ Toast ════════════════════ -->
        <Border x:Name="Toast" Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                CornerRadius="20" Padding="22,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Visibility="Collapsed">
            <TextBlock x:Name="TxtToast" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
        </Border>
    </Grid>
</Window>
